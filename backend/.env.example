# 複製成 .env 後依環境調整（Bun 會自動讀取 .env）
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://boarderless:boarderless@localhost:5433/boarderless
DATABASE_POOL_MAX=10
# dev：以 x-user-id header 識別使用者（正式 auth 尚未實作，見 PROGRESS.md）
AUTH_MODE=dev
# API 允許的 Web origin（逗號分隔）；* 只限開發
CORS_ORIGINS=*

# ---- Object storage ----
# s3：S3-compatible（docker compose 內的 RustFS；正式環境換成 AWS S3 / R2 等）
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# 簽發給 APP 的 endpoint；API 與 storage 在不同網路時設定（預設同 S3_ENDPOINT）
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=boarderless-assets
S3_ACCESS_KEY_ID=boarderless
S3_SECRET_ACCESS_KEY=boarderless-dev-secret
# 啟動時建立 bucket 並設定 CORS（只限開發；正式環境由 IaC 管理）
S3_ENSURE_BUCKET=true

# local：不需要 storage 服務，由本服務 /storage/objects 處理簽名 URL（只限開發 / 測試）
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# PUBLIC_BASE_URL=http://localhost:3000
# STORAGE_SIGNING_SECRET=change-me

# ---- Media ----
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_GC_GRACE_SECONDS=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Worker（bun run worker）----
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=5
UPLOAD_GC_INTERVAL_MS=60000
