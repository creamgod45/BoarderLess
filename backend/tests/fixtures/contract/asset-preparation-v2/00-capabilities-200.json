{
  "description": "能力宣告：APP 只在此存在時使用 preparation v2",
  "request": {
    "method": "GET",
    "path": "/api/v1/capabilities"
  },
  "response": {
    "status": 200,
    "body": {
      "canvas": {
        "protocolVersion": 1,
        "operationSchemaVersion": 1,
        "minWritableProtocolVersion": 1
      },
      "assetPreparation": {
        "requestSchema": "boarderless.asset-prepare.v1",
        "responseSchema": "boarderless.asset-preparation.v1",
        "maxByteSize": 209715200,
        "mediaTypes": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif",
          "video/mp4",
          "video/webm"
        ]
      },
      "realtime": {
        "supported": false
      },
      "quickSchemes": {
        "supported": false
      },
      "canvasStyle": {
        "supported": false
      },
      "relationGeometry": {
        "supported": false
      },
      "vectorPath": {
        "supported": false
      },
      "sequenceDiagrams": {
        "supported": false
      },
      "mediaReferenceRestore": {
        "supported": false
      }
    }
  }
}
