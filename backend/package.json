{
  "name": "boarderless-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BoarderLess Workspace 儲存與同步服務（Fastify + PostgreSQL，Bun runtime）",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "migrate": "bun src/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fixtures:media": "bun scripts/generate-media-fixtures.ts",
    "fixtures:contract": "bun scripts/generate-contract-fixtures.ts",
    "fixtures:canvas": "bun scripts/generate-canvas-fixtures.ts",
    "fixtures:preparation": "bun scripts/generate-preparation-fixtures.ts",
    "fixtures:realtime": "bun scripts/generate-realtime-fixtures.ts",
    "fixtures:quick-scheme": "bun scripts/generate-quick-scheme-fixtures.ts",
    "fixtures:canvas-style": "bun scripts/generate-canvas-style-fixtures.ts",
    "fixtures:graph": "bun scripts/generate-graph-fixtures.ts",
    "fixtures:sequence": "bun scripts/generate-sequence-fixtures.ts",
    "fixtures:media-restore": "bun scripts/generate-media-restore-fixtures.ts",
    "fixtures:all": "bun run fixtures:contract && bun run fixtures:canvas && bun run fixtures:preparation && bun run fixtures:realtime && bun run fixtures:quick-scheme && bun run fixtures:canvas-style && bun run fixtures:graph && bun run fixtures:sequence && bun run fixtures:media-restore",
    "acceptance:db-restart": "bun scripts/acceptance/db-restart.ts",
    "acceptance:multi-process": "bun scripts/acceptance/multi-process.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "11",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
