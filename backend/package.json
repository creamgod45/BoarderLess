{
  "name": "boarderless-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BoarderLess Workspace 儲存與同步服務（Fastify + PostgreSQL，Bun runtime）",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "migrate": "bun src/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fixtures:media": "bun scripts/generate-media-fixtures.ts",
    "fixtures:contract": "bun scripts/generate-contract-fixtures.ts",
    "fixtures:canvas": "bun scripts/generate-canvas-fixtures.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
