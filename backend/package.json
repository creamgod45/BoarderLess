{
  "name": "boarderless-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BoarderLess Workspace 儲存與同步服務（Fastify + PostgreSQL，Bun runtime）",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "migrate": "bun src/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
